<!--
  edt example: Linear algebra — matrices, cases, align, custom commands
  Shows: <pmatrix>, <bmatrix>, <cases>, <align>, <newcommand>,
         <declareoperator>, <frac>, <sqrt>, <env name="array">, <multicolumn>
-->

<document class="amsart">
  <usepackage name="amsmath"/>
  <usepackage name="amsthm"/>
  <usepackage name="amssymb"/>
  <usepackage name="mathtools"/>
  <usepackage name="geometry" options="margin=1in"/>

  <!-- Custom commands -->
  <newcommand cmd="\R">\mathbb{R}</newcommand>
  <newcommand cmd="\C">\mathbb{C}</newcommand>
  <newcommand cmd="\F">\mathbb{F}</newcommand>
  <newcommand cmd="\norm" args="1">\left\|#1\right\|</newcommand>
  <newcommand cmd="\inner" args="2">\langle #1,\, #2 \rangle</newcommand>
  <newcommand cmd="\abs"   args="1">\left|#1\right|</newcommand>

  <declareoperator cmd="\tr"   name="tr"/>
  <declareoperator cmd="\rank" name="rank"/>
  <declareoperator cmd="\diag" name="diag"/>
  <declareoperator cmd="\Span" name="span"/>

  <!-- Theorems -->
  <newtheorem name="theorem"   title="Theorem"/>
  <newtheorem name="lemma"     title="Lemma"     shared="theorem"/>
  <newtheorem name="corollary" title="Corollary" shared="theorem"/>
  <theoremstyle style="definition"/>
  <newtheorem name="definition" title="Definition"/>
  <theoremstyle style="remark"/>
  <newtheorem* name="remark" title="Remark"/>

  <body>
    <title>Eigenstructure and the Spectral Theorem</title>
    <author>N. Bosun</author>
    <date>\today</date>
    <maketitle/>

    <section name="Eigenvalues and the Characteristic Polynomial">

      <definition name="Eigenvalue">
        Let <m>A \in M_n(\R)</m>. A scalar <m>\lambda \in \C</m> is an
        <b>eigenvalue</b> of <m>A</m> if there exists a non-zero vector
        <m>\mathbf{v} \in \C^n</m> such that
        <m>A\mathbf{v} = \lambda \mathbf{v}</m>.
      </definition>

      <p>
        The eigenvalues are precisely the roots of the
        <b>characteristic polynomial</b>
        <eq id="eq:charpoly">
          p_A(\lambda) \;=\; \det(\lambda I - A) \;=\;
          \lambda^n - (\tr A)\,\lambda^{n-1} + \cdots + (-1)^n \det A.
        </eq>
        The coefficients of <eqref id="eq:charpoly"/> are symmetric functions
        of the eigenvalues <m>\lambda_1, \ldots, \lambda_n</m>:
        <align>
          \tr A      \amp= \sum_{i=1}^n \lambda_i, \\
          \det A     \amp= \prod_{i=1}^n \lambda_i.
        </align>
      </p>

      <p>
        A concrete <m>3\times 3</m> example. Let
        <dmath>
          A = \begin{pmatrix}
                6 &amp; -3 &amp; 1 \\
                0 &amp;  4 &amp; 2 \\
                0 &amp;  0 &amp; 3
              \end{pmatrix}.
        </dmath>
        Since <m>A</m> is upper triangular its eigenvalues are the diagonal
        entries: <m>\lambda_1 = 6</m>, <m>\lambda_2 = 4</m>,
        <m>\lambda_3 = 3</m>. Verify:
        <dmath>
          p_A(\lambda) = (\lambda - 6)(\lambda - 4)(\lambda - 3).
        </dmath>
      </p>

    </section>

    <section name="Diagonalisation">

      <theorem id="thm:diag">
        A matrix <m>A \in M_n(\R)</m> is diagonalisable over <m>\R</m> if and
        only if it has <m>n</m> linearly independent eigenvectors. In that
        case <m>A = P D P^{-1}</m> where
        <m>D = \diag(\lambda_1, \ldots, \lambda_n)</m> and the columns of
        <m>P</m> are the corresponding eigenvectors.
      </theorem>

      <p>
        The diagonalisation can be written block-wise. Suppose <m>n = 4</m>
        with eigenvalues <m>\lambda_1 = \lambda_2 = 2</m>,
        <m>\lambda_3 = -1</m>, <m>\lambda_4 = 3</m>:
        <dmath>
          D = \begin{bmatrix}
                2 &amp; 0 &amp; 0 &amp; 0 \\
                0 &amp; 2 &amp; 0 &amp; 0 \\
                0 &amp; 0 &amp; -1 &amp; 0 \\
                0 &amp; 0 &amp; 0 &amp; 3
              \end{bmatrix}.
        </dmath>
      </p>

      <corollary>
        If <m>A</m> has <m>n</m> distinct eigenvalues then <m>A</m> is
        diagonalisable.
      </corollary>

    </section>

    <section name="The Spectral Theorem">

      <theorem name="Spectral Theorem (real symmetric case)" id="thm:spectral">
        Let <m>A \in M_n(\R)</m> be symmetric. Then:
        <ol>
          <li>All eigenvalues of <m>A</m> are real.</li>
          <li>Eigenvectors corresponding to distinct eigenvalues are
              orthogonal.</li>
          <li>There exists an orthogonal matrix <m>Q</m> such that
              <m>A = Q \Lambda Q^\top</m>, where
              <m>\Lambda = \diag(\lambda_1, \ldots, \lambda_n)</m>.</li>
        </ol>
      </theorem>

      <proof>
        We prove (1). Let <m>\lambda \in \C</m> be an eigenvalue with
        eigenvector <m>\mathbf{v} \neq 0</m>. Then
        <align>
          \lambda \inner{\mathbf{v}}{\mathbf{v}}
            \amp= \inner{A\mathbf{v}}{\mathbf{v}}
             = \inner{\mathbf{v}}{A^\top\mathbf{v}}
             = \inner{\mathbf{v}}{A\mathbf{v}}
             = \bar{\lambda}\inner{\mathbf{v}}{\mathbf{v}}.
        </align>
        Since <m>\inner{\mathbf{v}}{\mathbf{v}} > 0</m> we get
        <m>\lambda = \bar\lambda</m>, so <m>\lambda \in \R</m>.
        Parts (2) and (3) follow by induction on <m>n</m>.
      </proof>

    </section>

    <section name="Matrix Functions and the Cayley-Hamilton Theorem">

      <theorem name="Cayley-Hamilton">
        Every square matrix satisfies its own characteristic polynomial:
        <m>p_A(A) = 0</m>.
      </theorem>

      <p>
        This allows matrix inverses and powers to be expressed as polynomials
        in <m>A</m>. For <m>2 \times 2</m> matrices, <m>p_A(\lambda) =
        \lambda^2 - (\tr A)\lambda + \det A</m>, giving
        <m>A^{-1} = \frac{1}{\det A}((\tr A)I - A)</m>.
      </p>

      <p>
        For the matrix exponential, when <m>A</m> is diagonalisable:
        <dmath>
          e^A \;=\; P \begin{pmatrix}
                        e^{\lambda_1} &amp;        &amp; 0            \\
                                      &amp; \ddots &amp;              \\
                        0             &amp;        &amp; e^{\lambda_n}
                      \end{pmatrix} P^{-1}.
        </dmath>
      </p>

      <!-- Using the generic env tag for a custom array layout -->
      <p>
        The sign function of a matrix is defined via its eigenvalues:
        <dmath>
          \operatorname{sign}(\lambda) \;=\;
          <env name="cases">
            +1 \amp \text{if } \lambda > 0, \\
            \phantom{+}0  \amp \text{if } \lambda = 0, \\
            -1 \amp \text{if } \lambda &lt; 0.
          </env>
        </dmath>
      </p>

    </section>

    <section name="Singular Value Decomposition">

      <theorem name="SVD">
        Every matrix <m>A \in M_{m \times n}(\R)</m> admits a factorisation
        <dmath>
          A \;=\; U \Sigma V^\top,
        </dmath>
        where <m>U \in O(m)</m>, <m>V \in O(n)</m> are orthogonal, and
        <m>\Sigma \in M_{m \times n}(\R)</m> is diagonal with non-negative
        entries <m>\sigma_1 \geq \sigma_2 \geq \cdots \geq \sigma_r > 0</m>,
        <m>r = \rank A</m>.
      </theorem>

      <remark>
        The singular values <m>\sigma_i</m> are the square roots of the
        eigenvalues of <m>A^\top A</m>:
        <m>\sigma_i = \sqrt{\lambda_i(A^\top A)}</m>. They are invariant under
        orthogonal transformations and completely determine
        <m>\norm{A}_2 = \sigma_1</m> and
        <m>\norm{A}_F = \sqrt{\sigma_1^2 + \cdots + \sigma_r^2}</m>.
      </remark>

    </section>

  </body>
</document>
